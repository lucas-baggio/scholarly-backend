# =============================================================================
# Variáveis para deploy (Docker Compose)
# Copie para .env e preencha com valores reais. Nunca commite .env.
# =============================================================================

# PostgreSQL (serviço db no docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=laboratorio

# Conexão com o banco (desenvolvimento local use localhost; no Docker a API usa db:5432)
DATABASE_URL="postgresql://app:change-me-in-production@localhost:5432/laboratorio"

# App
PORT=3000

# Auth (obrigatório em produção: use um secret forte e único)
JWT_SECRET=change-me-in-production-use-long-random-string
